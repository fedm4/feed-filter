# Base URL to build PR links (concatenate the number): pr:review PR=12 -> $(REPO_PULL_URL)12
REPO_PULL_URL=https://github.com/<owner>/<repo>/pull/

# GitHub: personal access token with 'repo' scope for pr-agent to read/comment on PRs
GITHUB__USER_TOKEN=
GITHUB__DEPLOYMENT_TYPE=user

# Model for pr-agent, and the key of its provider. Uncomment the one you use.
CONFIG__MODEL=gemini/<model, e.g. gemini-3.8-flash>
GEMINI_API_KEY=
# CONFIG__MODEL=anthropic/<model, e.g. claude-sonnet-4-5-20250929>
# ANTHROPIC__KEY=

# Context window of CONFIG__MODEL. Without it, a model pr-agent doesn't know
# ("not defined in MAX_TOKENS") is dropped for the fallback one.
CONFIG__CUSTOM_MODEL_MAX_TOKENS=


# ---------------------------------------------------------------------------
# Application settings. Every one is optional: the defaults below are what the
# code uses. Anything set here is also exported into `make` targets, so keep
# test-affecting values out unless you mean it.
# ---------------------------------------------------------------------------

FF_TZ=Europe/Madrid
FF_UI_LANG=es                 # interface language; must have a translation catalogue

# Laya runs natively on the host, never in this stack. From a container on Linux,
# host.docker.internal resolves via the extra_hosts entry in docker-compose.yml.
FF_CATALOG_PATH=data/catalog.yaml
FF_LAYA_BASE_URL=http://host.docker.internal:8000
# Empty lets the server auto-route by detected language, which scores better than
# pinning. Set a checkpoint id only to override that.
FF_LAYA_MODEL=
FF_LAYA_API_KEY=
FF_LAYA_TIMEOUT_S=60

FF_USER_AGENT=feed-filter/0.1
FF_DEDUP_THRESHOLD=90
FF_DEDUP_WINDOW_HOURS=48
FF_DEDUP_MIN_TITLE_CHARS=40
FF_CLASSIFY_MAX_PER_CYCLE=200
FF_POLL_MINUTES=30
FF_FETCH_FULL_TEXT=false      # fetch article bodies; multiplies requests to news sites
FF_RETENTION_DAYS=30

# Filtering. Relevance: irrelevant < marginal < interesting < essential
# Sensationalism: factual < slanted < clickbait < tabloid
FF_MIN_RELEVANCE=marginal
FF_MAX_SENSATIONALISM=clickbait
FF_OPINION_POLICY=tag         # tag | collapse | hide -- the badge always renders
FF_HIDE_PROMOTION=true

FF_DIGEST_TIMES=08:30         # comma-separated, local to FF_TZ
FF_DIGEST_MAX_PER_TOPIC=8

FF_DB_PATH=data/feedfilter.db
FF_CONFIG_PATH=data/config.yaml

FF_HOST=0.0.0.0
FF_PORT=8080
FF_LOG_LEVEL=info
